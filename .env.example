# AIPS example environment file
#
# Copy this file to .env and replace the placeholder values:
#   cp .env.example .env
# Never commit .env (it is listed in .gitignore).
#
# How it is used:
# - `docker compose` reads .env automatically and fills in the ${...} values
#   in docker-compose.yml (notification and AI services).
# - The backend runs on the host. Start it from backend/ with
#   `uvicorn app.main:app --env-file ../.env ...` so it reads the same file.

# ---------------------------------------------------------------------------
# Backend (runs on the host)
# ---------------------------------------------------------------------------

# Deployment environment. With ENV=production the backend refuses to start
# unless JWT_SECRET is set to a real secret.
ENV=dev

# Secret used to sign login tokens (JWT). Replace "change-me" with a long
# random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If it is empty or still a placeholder, the backend logs a security
# warning (an empty value falls back to a public development secret).
JWT_SECRET=change-me

# DEV-ONLY database URL. It matches the local Postgres credentials in
# docker-compose.yml. Use your own credentials anywhere else.
DATABASE_URL=postgresql+psycopg://aips:aips@localhost:5432/aips

# Allowed browser origins (comma-separated). "*" is fine for local development;
# list your real frontend origin(s) in production.
CORS_ORIGINS=*

# Notification service URL as seen from the host (the default
# http://notification:8004 only resolves inside Docker).
NOTIFICATION_SERVICE_URL=http://localhost:8004

# Folder where the AI service saves clips, relative to backend/.
CLIPS_DIR=../clips

# ---------------------------------------------------------------------------
# Notification service (docker compose)
# ---------------------------------------------------------------------------

# "console" prints emails to the log. Use "smtp" to send real emails.
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional Telegram alerts. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
